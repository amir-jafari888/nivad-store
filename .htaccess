RewriteEngine On

# Canonical admin panel entry.
RewriteRule ^admin/?$ /nivad-panel/ [R=301,L]
RewriteRule ^admin/(.*)$ /nivad-panel/$1 [R=301,L,NE]

# Canonical extensionless PHP URLs inside the renamed panel.
RewriteCond %{THE_REQUEST} \s/+nivad-panel/index\.php(?:[?\s]) [NC]
RewriteRule ^nivad-panel/index\.php$ /nivad-panel/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+nivad-panel/(.+?)\.php(?:[?\s]) [NC]
RewriteRule ^nivad-panel/(.+)\.php$ /nivad-panel/$1 [R=301,L,NE]

# Clean URL -> matching flat PHP endpoint (for example /reports/sales).
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^nivad-panel/(.+?)/?$ nivad-panel/$1.php [L,QSA]

# Clean URL -> directory index.php (for example /products).
RewriteCond %{REQUEST_FILENAME}/index.php -f
RewriteRule ^nivad-panel/(.+?)/?$ nivad-panel/$1/index.php [L,QSA]

# Admin logout remains a direct POST + CSRF-protected endpoint.
RewriteRule ^nivad-panel/logout/?$ nivad-panel/logout.php [L,QSA]

RewriteRule ^sitemap\.xml$ api/index.php?path=/seo/sitemap [L,QSA]
RewriteRule ^robots\.txt$ api/index.php?path=/seo/robots [L,QSA]

# Storefront
RewriteRule ^products/?$ pages/store/products/index.php [L,QSA]
RewriteRule ^products/([^/]+)/?$ pages/store/products/show.php?slug=$1 [L,QSA]
RewriteRule ^categories/([^/]+)/?$ pages/store/category/show.php?slug=$1 [L,QSA]
RewriteRule ^search/?$ pages/store/search/index.php [L,QSA]
RewriteRule ^brands/([^/]+)/?$ pages/store/brand/show.php?slug=$1 [L,QSA]
RewriteRule ^discover/?$ pages/store/discover/show.php [L,QSA]
RewriteRule ^collections/([^/]+)/?$ pages/store/collection/show.php?slug=$1 [L,QSA]
RewriteRule ^finder/?$ pages/store/finder/index.php [L,QSA]
RewriteRule ^budget-optimizer/?$ pages/store/budget-optimizer/index.php [L,QSA]
RewriteRule ^setup/?$ pages/store/setup.php [L,QSA]

# Customer Commerce
RewriteRule ^account/support/?$ pages/account/support.php [L,QSA]
RewriteRule ^cart/?$ pages/shop/cart.php [L,QSA]
RewriteRule ^wishlist/?$ pages/shop/wishlist.php [L,QSA]
RewriteRule ^checkout/?$ pages/shop/checkout.php [L,QSA]
RewriteRule ^payment/success/?$ pages/shop/payment/success.php [L,QSA]
RewriteRule ^payment/failed/?$ pages/shop/payment/failed.php [L,QSA]
