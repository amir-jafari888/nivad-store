RewriteEngine On

# Admin public URL space
# Physical implementation remains under /admin; the public canonical prefix is /nivad-panel.
# Legacy /admin requests are redirected only when they came directly from the browser.
RewriteCond %{THE_REQUEST} \s/+admin/logout(?:\.php)?(?:[/?\s]) [NC]
RewriteRule ^admin/logout(?:\.php)?/?$ /nivad-panel/logout [R=302,L,NE]

RewriteCond %{THE_REQUEST} \s/+admin(?:[/?\s]) [NC]
RewriteRule ^admin(?:/(.*))?/?$ /nivad-panel/$1 [R=302,L,NE]

# Product management pages use PHP files without exposing the .php suffix.
RewriteRule ^nivad-panel/products/?$ admin/products/index.php [END,QSA]
RewriteRule ^nivad-panel/products/create/?$ admin/products/create.php [END,QSA]
RewriteRule ^nivad-panel/products/edit/?$ admin/products/edit.php [END,QSA]

# Category management pages use the same PHP-file routing contract as products.
RewriteRule ^nivad-panel/categories/?$ admin/categories/index.php [END,QSA]
RewriteRule ^nivad-panel/categories/create/?$ admin/categories/create.php [END,QSA]
RewriteRule ^nivad-panel/categories/edit/?$ admin/categories/edit.php [END,QSA]

# Attribute management pages keep list, create and edit URLs canonical.
RewriteRule ^nivad-panel/attributes/?$ admin/attributes/index.php [END,QSA]
RewriteRule ^nivad-panel/attributes/create/?$ admin/attributes/create.php [END,QSA]
RewriteRule ^nivad-panel/attributes/edit/?$ admin/attributes/edit.php [END,QSA]

# Collection management pages keep the index and edit views on canonical admin URLs.
RewriteRule ^nivad-panel/collections/?$ admin/collections/index.php [END,QSA]
RewriteRule ^nivad-panel/collections/edit/?$ admin/collections/edit.php [END,QSA]

# Brand management pages use the same PHP-file routing contract as products and categories.
RewriteRule ^nivad-panel/brands/?$ admin/brands/index.php [END,QSA]
RewriteRule ^nivad-panel/brands/create/?$ admin/brands/create.php [END,QSA]
RewriteRule ^nivad-panel/brands/edit/?$ admin/brands/edit.php [END,QSA]

# Canonical admin routes -> physical /admin implementation.
# END prevents a second per-directory rewrite pass after the internal mapping.
RewriteRule ^nivad-panel/?$ admin/index.php [END,QSA]
RewriteRule ^nivad-panel/logout/?$ admin/logout.php [END,QSA]
RewriteRule ^nivad-panel/(.+)$ admin/$1 [END,QSA]

RewriteRule ^sitemap\.xml$ api/index.php?path=/seo/sitemap [L,QSA]
RewriteRule ^robots\.txt$ api/index.php?path=/seo/robots [L,QSA]

# Storefront
RewriteRule ^products/?$ pages/store/products/index.php [L,QSA]
RewriteRule ^products/([^/]+)/?$ pages/store/products/show.php?slug=$1 [L,QSA]
RewriteRule ^categories/([^/]+)/?$ pages/store/category/show.php?slug=$1 [L,QSA]
RewriteRule ^search/?$ pages/store/search/index.php [L,QSA]
RewriteRule ^brands/([^/]+)/?$ pages/store/brand/show.php?slug=$1 [L,QSA]
RewriteRule ^discover/?$ pages/store/discover/show.php [L,QSA]
RewriteRule ^collections/([^/]+)/?$ pages/store/collection/show.php?slug=$1 [L,QSA]
RewriteRule ^finder/?$ pages/store/finder/index.php [L,QSA]
RewriteRule ^budget-optimizer/?$ pages/store/budget-optimizer/index.php [L,QSA]
RewriteRule ^setup/?$ pages/store/setup.php [L,QSA]

# Customer Commerce
RewriteRule ^account/support/?$ pages/account/support.php [L,QSA]
RewriteRule ^cart/?$ pages/shop/cart.php [L,QSA]
RewriteRule ^wishlist/?$ pages/shop/wishlist.php [L,QSA]
RewriteRule ^checkout/?$ pages/shop/checkout.php [L,QSA]
RewriteRule ^payment/success/?$ pages/shop/payment/success.php [L,QSA]
RewriteRule ^payment/failed/?$ pages/shop/payment/failed.php [L,QSA]